; Engine configuration file.
; SDK standalone project: lets `bash scripts/run_tests.sh sdk` run sdk/tests headlessly.
; Games may copy sdk/ in or reference it; input actions below are the ones the
; prefabs expect (move_*, sprint, interact).
config_version=5

[application]

config/name="godot-factory-sdk"
config/features=PackedStringArray("4.7")

